{
  "name": "automatize-it-platform",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "turbo run test --filter=web",
    "lint": "turbo run lint --filter=web",
    "typecheck": "turbo run typecheck --filter=web",
    "build:web": "turbo run build --filter=web",
    "api:lint": "redocly lint --config .redocly.yaml",
    "api:bundle": "redocly bundle specs/api/openapi.yaml -o specs/api/dist/openapi.yaml",
    "api:docs": "redocly preview-docs specs/api/openapi.yaml",
    "api:spectral": "redocly bundle specs/api/openapi.yaml -o specs/api/dist/openapi.yaml && spectral lint specs/api/dist/openapi.yaml",
    "api:generate": "orval --config orval.config.ts",
    "api:validate": "npm run api:lint && npm run api:spectral"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "packageManager": "pnpm@11.18.0",
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@openapitools/openapi-generator-cli": "^2.40.1",
    "@redocly/cli": "^2.43.2",
    "@stoplight/spectral-cli": "^6.16.2",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "orval": "^8.23.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "turbo": "^2.10.8",
    "typescript": "^5.9.2"
  }
}
