# Infraestructura de despliegue — Docker Compose (producción)
#
# Uso:
#   cp infrastructure/docker/.env.example infrastructure/docker/.env
#   $EDITOR infrastructure/docker/.env        # valores reales, nunca commiteados
#   docker compose -f infrastructure/docker/docker-compose.yml up -d
#
# docker-compose.yml usa `${VAR:?mensaje}`: si falta una variable obligatoria,
# el despliegue falla de inmediato con un mensaje legible en lugar de arrancar
# una API con configuración rota.
#
# infrastructure/docker/.env está en .gitignore. No lo subas a Git.

# ---------------------------------------------------------------------------
# OBLIGATORIAS
# ---------------------------------------------------------------------------

# Contraseña de PostgreSQL. Mínimo 32 caracteres de contenido URL-safe
# (la inyectamos dentro de DATABASE_URL):  openssl rand -hex 32
# Solo se aplica en el PRIMER arranque del volumen; si ya existe el volumen,
# debe coincidir con la contraseña con la que se inicializó, o el API no podrá
# conectarse.
POSTGRES_PASSWORD=

# Opciones de base de datos. Déjalas tal cual salvo que cambies la inicialización.
# POSTGRES_DB=automatizeit
# POSTGRES_USER=automatizeit

# Origen del frontend (Next.js). Obligatoria: antes había un default
# http://localhost:3000 que en producción dejaba la API mal configurada.
CORS_ORIGIN=

# Seguridad de sesión. Mínimo 32 caracteres:  openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# Integración Meta WhatsApp Cloud API (obligatorias para el arranque del API).
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_DEFAULT_ORGANIZATION_ID=

# ---------------------------------------------------------------------------
# OPCIONALES — añade solo las integraciones que actives
# ---------------------------------------------------------------------------

# Pancake (WhatsApp saliente). Vacío = el envío no se enruta a Pancake.
# Ver apps/api/.env.example y specs/API-Pancake/integration.md.
# PANCAKE_API_TOKEN=
# PANCAKE_BOTCAKE_API_TOKEN=
# PANCAKE_TEMPLATE_ID=
# PANCAKE_PAGE_ID=
# PANCAKE_API_BASE_URL=
# PANCAKE_TEMPLATES_API_URL=
# PANCAKE_SENDER_ID=
# PANCAKE_ORGANIZATION_ID=       # activar APAGA la simulación sandbox
# PANCAKE_TIMEOUT_MS=
# PANCAKE_MIN_INTERVAL_MS=
# PANCAKE_RESOLVE_CONVERSATION_ID=
# PANCAKE_RETRY_ON_AMBIGUOUS=

# SMS (specs/022-sms-v1) — fuera del alcance de esta fase.
# Ver apps/api/.env.example.

# Organizaciones de sandbox de Meta (enrutado de pruebas).
# WHATSAPP_SANDBOX_ORGANIZATION_IDS=
