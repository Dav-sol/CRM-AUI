// ---------------------------------------------------------------------------
// Fase 2: Biblioteca de copy (specs/Biblioteca/biblioteca.md). Plantillas
// reutilizables por intención comercial, org-scoped, sembradas con las 150
// piezas (50 bases × 3 tonos).
// ---------------------------------------------------------------------------

enum TemplateCategory {
  CAMPAIGN
  FOLLOW_UP
  QUICK_REPLY
}

enum TemplateTone {
  PROFESSIONAL
  CARIBE_COMMERCIAL
  CARIBE_AUTHENTIC
}

enum TemplateAngle {
  TRUST
  PREVENTION
  REPURCHASE
  LOYALTY
  CONVERSATION
  CALM
}

model Template {
  id             String           @id @default(cuid())
  uuid           String           @unique @default(uuid())
  organizationId String           @map("organization_id")
  // Código de la biblioteca (ej: BW-001); null para plantillas propias.
  code           String?
  name           String
  // Categoría comercial de la biblioteca (ej: "Bienvenida y postventa").
  group          String?
  category       TemplateCategory @default(CAMPAIGN)
  tone           TemplateTone     @default(PROFESSIONAL)
  angle          TemplateAngle
  goal           String?
  recommendedUse String?          @map("recommended_use")
  body           String
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([organizationId, category])
  @@map("templates")
}
