generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String             @id @default(cuid())
  uuid      String             @unique @default(uuid())
  name      String
  slug      String             @unique
  nit       String?            @unique
  email     String?
  phone     String?
  city      String?
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  deletedAt DateTime?          @map("deleted_at")

  Role                       Role[]
  users                      User[]
  customers                  Customer[]
  products                   Product[]
  purchases                  Purchase[]
  campaigns                  Campaign[]
  automations                Automation[]
  followUpSequences          FollowUpSequence[]
  conversations              Conversation[]
  messages                   Message[]
  imports                    Import[]
  audits                     Audit[]
  invitations                Invitation[]
  conversationTags           ConversationTag[]
  conversationTagAssignments ConversationTagAssignment[]
  conversationNotes          ConversationNote[]
  quickReplies               QuickReply[]
  templates                  Template[]
  channelAccounts            ChannelAccount[]
  config                     OrganizationConfig?
  complaints                 Complaint[]
  consents                   LifecycleConsent[]

  @@map("organizations")
}

model User {
  id             String      @id @default(cuid())
  uuid           String      @unique @default(uuid())
  organizationId String?     @map("organization_id")
  roleId         String?     @map("role_id")
  accountType    AccountType @default(ORGANIZATION) @map("account_type")
  firstName      String      @map("first_name")
  lastName       String      @map("last_name")
  email          String      @unique
  passwordHash   String      @map("password_hash")
  status         UserStatus  @default(INVITED)
  lastLogin      DateTime?   @map("last_login")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  deletedAt      DateTime?   @map("deleted_at")

  organization      Organization?               @relation(fields: [organizationId], references: [id])
  role              Role?                       @relation(fields: [roleId], references: [id])
  sessions          UserSession[]
  invitationsSent   Invitation[]                @relation("Inviter")
  passwordResets    PasswordResetToken[]
  conversations     Conversation[]              @relation("ConversationAdvisor")
  imports           Import[]
  audits            Audit[]
  conversationNotes ConversationNote[]          @relation("ConversationNoteAuthor")
  tagAssignments    ConversationTagAssignment[] @relation("ConversationTagAssignmentCreator")
  quickReplies      QuickReply[]                @relation("QuickReplyCreator")

  @@index([organizationId])
  @@map("users")
}

model Role {
  id             String   @id @default(cuid())
  uuid           String   @unique @default(uuid())
  organizationId String?  @map("organization_id")
  name           RoleType
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id])
  users        User[]

  @@unique([organizationId, name])
  @@map("roles")
}

model Customer {
  id             String         @id @default(cuid())
  uuid           String         @unique @default(uuid())
  organizationId String         @map("organization_id")
  codcli         String
  name           String
  phone          String?
  email          String?
  address        String?
  city           String?
  status         CustomerStatus @default(ACTIVE)
  // Fase 5 (T19): opt-out "No contactar" (playbook §15). Cuando está set, el
  // cliente no recibe envíos comerciales ni automatizaciones. Null = permitido.
  noContactAt     DateTime?      @map("no_contact_at")
  noContactReason String?        @map("no_contact_reason")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")
  createdBy      String?        @map("created_by")
  updatedBy      String?        @map("updated_by")
  deletedBy      String?        @map("deleted_by")

  organization  Organization   @relation(fields: [organizationId], references: [id])
  purchases     Purchase[]
  conversations Conversation[]
  messages      Message[]
  consents      LifecycleConsent[]

  @@unique([organizationId, codcli])
  @@index([organizationId])
  @@index([phone])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("customers")
}

model Product {
  id             String        @id @default(cuid())
  uuid           String        @unique @default(uuid())
  organizationId String        @map("organization_id")
  code           String
  name           String
  category       String?
  status         ProductStatus @default(ACTIVE)
  warrantyMonths Int?          @map("warranty_months")
  // Fase urgente: precio de referencia (catálogo). La cotización lo prellena
  // y el vendedor puede modificarlo.
  price          Decimal?      @db.Decimal(12, 2) @map("price")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")
  createdBy      String?       @map("created_by")
  updatedBy      String?       @map("updated_by")
  deletedBy      String?       @map("deleted_by")

  organization Organization @relation(fields: [organizationId], references: [id])
  purchases    Purchase[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("products")
}

model Purchase {
  id                String         @id @default(cuid())
  uuid              String         @unique @default(uuid())
  organizationId    String         @map("organization_id")
  customerId        String         @map("customer_id")
  productId         String         @map("product_id")
  invoiceNumber     String         @map("invoice_number")
  purchaseDate      DateTime       @map("purchase_date")
  warrantyMonths    Int?           @map("warranty_months")
  warrantyExpiresAt DateTime?      @map("warranty_expires_at")
  // Lifecycle 025 §1: la fecha de instalación es la fecha base del lifecycle.
  // Null = la venta existe pero la batería aún no consta como instalada, por
  // lo que NO hay lifecycle (gate G8). ERP puede corregirla: se usa la última.
  installationDate  DateTime?      @map("installation_date")
  // Atribución de ventas (Fase 2): conversación que originó la venta (uuid).
  sourceConversationId String?     @map("source_conversation_id")
  // Fase P0-C: cotización que originó la venta (uuid).
  quoteId             String?      @map("quote_id")
  // Fase 8: atribución explícita CRM vs redes sociales.
  source              PurchaseSource @default(CRM)
  quantity          Int
  value             Decimal        @db.Decimal(12, 2)
  status            PurchaseStatus @default(COMPLETED)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  deletedAt         DateTime?      @map("deleted_at")
  createdBy         String?        @map("created_by")
  updatedBy         String?        @map("updated_by")

  organization     Organization     @relation(fields: [organizationId], references: [id])
  customer         Customer         @relation(fields: [customerId], references: [id])
  product          Product          @relation(fields: [productId], references: [id])
  commercialCycle  CommercialCycle?
  automations      Automation[]

  @@unique([organizationId, invoiceNumber, customerId, productId, purchaseDate])
  @@index([organizationId])
  @@index([customerId])
  @@index([purchaseDate])
  @@index([invoiceNumber])
  @@index([organizationId, status])
  @@index([organizationId, purchaseDate])
  @@map("purchases")
}

// Fase P0-C: cotización simple (un producto + cantidad). Conserva la cadena de
// atribución: campaña → mensaje → conversación → cotización → venta. Los IDs
// son escalares (sin @relation) como sourceConversationId/quoteId.
model Quote {
  id             String      @id @default(cuid())
  uuid           String      @unique @default(uuid())
  organizationId String      @map("organization_id")
  conversationId String?     @map("conversation_id")
  customerId     String?     @map("customer_id")
  campaignId     String?     @map("campaign_id")
  productId      String?     @map("product_id")
  quantity       Int         @default(1)
  value          Decimal     @db.Decimal(12, 2)
  status         QuoteStatus @default(DRAFT)
  purchaseId     String?     @map("purchase_id")
  note           String?     @map("note")
  sentAt         DateTime?   @map("sent_at")
  acceptedAt     DateTime?   @map("accepted_at")
  rejectedAt     DateTime?   @map("rejected_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  deletedAt      DateTime?   @map("deleted_at")
  createdBy      String?     @map("created_by")
  updatedBy      String?     @map("updated_by")

  @@index([organizationId])
  @@index([customerId])
  @@index([conversationId])
  @@index([campaignId])
  @@index([status])
  @@map("quotes")
}

model CommercialCycle {
  id         String                @id @default(cuid())
  uuid       String                @unique @default(uuid())
  purchaseId String                @unique @map("purchase_id")
  status     CommercialCycleStatus @default(ACTIVE)
  startDate  DateTime              @map("start_date")
  endDate    DateTime?             @map("end_date")
  // Lifecycle 025 §4: pausa transversal (G1). Se levanta al cerrar el caso que
  // la originó; al reanudar, lo vencido pasa a SKIPPED (§4.5).
  lifecyclePausedAt DateTime?        @map("lifecycle_paused_at")
  pauseReason      LifecyclePauseReason?      @map("pause_reason")
  // Contadores de intento de negocio (§3, §4.7). Los fallos técnicos de envío
  // usan retryCount y NO cuentan como intento.
  maintenanceAttempts Int @default(0) @map("maintenance_attempts")
  // §3: máximo una solicitud de reseña efectiva por cliente/ciclo.
  reviewRequestedAt DateTime? @map("review_requested_at")
  // §4.7: rechazo explícito del consentimiento de mantenimiento. Distinto de
  // "no respondió": ambos bloquean las revisiones, solo este registra la causa.
  maintenanceOptOutAt DateTime? @map("maintenance_opt_out_at")
  // §26: por qué terminó el lifecycle, si terminó.
  terminationReason LifecycleTerminationReason? @map("termination_reason")
  terminatedAt      DateTime?                    @map("terminated_at")
  createdBy  String?               @map("created_by")
  updatedBy  String?               @map("updated_by")
  deletedBy  String?               @map("deleted_by")
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")
  deletedAt  DateTime?             @map("deleted_at")

  purchase    Purchase     @relation(fields: [purchaseId], references: [id])
  automations Automation[]
  complaints  Complaint[]
  consents    LifecycleConsent[]

  @@map("commercial_cycles")
}

// Reclamación como caso auditable (spec 025 §6): apertura, resolución,
// resultado y trazabilidad. No es un tag de conversación.
model Complaint {
  id             String                @id @default(cuid())
  uuid           String                @unique @default(uuid())
  organizationId String                @map("organization_id")
  // Un lifecycle puede tener como máximo una reclamación ABIERTA a la vez.
  cycleId        String                @map("cycle_id")
  conversationId String?               @map("conversation_id")
  openedAt       DateTime              @default(now()) @map("opened_at")
  openedReason   String                @map("opened_reason")
  openedBy       ComplaintOpenedBy     @map("opened_by")
  detectedBy     ComplaintOpenedBy     @map("detected_by")
  resolvedAt     DateTime?             @map("resolved_at")
  resolution     ComplaintResolution?  @map("resolution")
  resolutionNotes String?              @map("resolution_notes")
  resolvedBy     String?               @map("resolved_by")
  createdBy      String?               @map("created_by")
  updatedBy      String?               @map("updated_by")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  deletedAt      DateTime?             @map("deleted_at")

  organization Organization     @relation(fields: [organizationId], references: [id])
  cycle        CommercialCycle @relation(fields: [cycleId], references: [id])
  conversation Conversation?   @relation(fields: [conversationId], references: [id])

  @@index([organizationId])
  @@index([cycleId])
  @@index([organizationId, resolvedAt])
  @@map("complaints")
}

// Consentimiento auditable (spec 025 §4.6). No hay consentimiento implícito:
// la ausencia de registro equivale a "no consentido" (§3.1).
model LifecycleConsent {
  id             String          @id @default(cuid())
  uuid           String          @unique @default(uuid())
  organizationId String          @map("organization_id")
  customerId     String          @map("customer_id")
  // Null cuando aún no hay lifecycle al que atribuírselo.
  cycleId        String?         @map("cycle_id")
  scope          ConsentScope
  decision       ConsentDecision
  decidedAt      DateTime        @default(now()) @map("decided_at")
  decidedBy      String?         @map("decided_by")
  source         ConsentSource
  sourceMessageId String?        @map("source_message_id")
  expiresAt      DateTime?       @map("expires_at")
  revokedAt      DateTime?       @map("revoked_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id])
  customer     Customer         @relation(fields: [customerId], references: [id])
  cycle        CommercialCycle? @relation(fields: [cycleId], references: [id])

  @@index([organizationId, customerId, scope])
  @@index([cycleId])
  @@index([organizationId, customerId, scope, decidedAt])
  @@map("lifecycle_consents")
}

model Campaign {
  id                    String         @id @default(cuid())
  uuid                  String         @unique @default(uuid())
  organizationId        String         @map("organization_id")
  name                  String
  description           String?
  type                  CampaignType
  template              String
  templateD3            String?        @map("template_d3")
  templateD180          String?        @map("template_d180")
  templateD365          String?        @map("template_d365")
  status                CampaignStatus @default(DRAFT)
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  deletedAt             DateTime?      @map("deleted_at")

  startAt              DateTime?       @map("start_at")
  segment              Json?           @map("segment")
  // Fase 1: etapas propias de la campaña (timeline inline). Misma forma que
  // FollowUpSequenceStage sin uuid: { name?, anchor, offsetDays, template,
  // templateOnPast? }. Se usan cuando no hay followUpSequenceId.
  stages               Json?           @map("stages")
  followUpSequenceId   String?         @map("follow_up_sequence_id")

  // Fase 1: canal de envío (SMS, WHATSAPP_CLIENTS, WHATSAPP_SOCIAL).
  channel              ChannelType     @default(WHATSAPP_CLIENTS)
  channelAccountId     String?         @map("channel_account_id")

  organization         Organization    @relation(fields: [organizationId], references: [id])
  automations           Automation[]
  followUpSequence     FollowUpSequence? @relation(fields: [followUpSequenceId], references: [id])
  channelAccount       ChannelAccount?  @relation(fields: [channelAccountId], references: [id])

  @@index([organizationId])
  @@map("campaigns")
}

model FollowUpSequence {
  id             String   @id @default(cuid())
  uuid           String   @unique @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  warrantyMonths Int      @map("warranty_months")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?  @map("deleted_by")
  createdBy      String?  @map("created_by")
  updatedBy      String?  @map("updated_by")

  organization Organization                  @relation(fields: [organizationId], references: [id])
  stages       FollowUpSequenceStage[]
  campaigns    Campaign[]

  @@index([organizationId])
  @@map("follow_up_sequences")
}

model FollowUpSequenceStage {
  id                  String               @id @default(cuid())
  uuid                String               @unique @default(uuid())
  sequenceId          String               @map("sequence_id")
  name                String
  // Temporal reference for offsetDays:
  // PURCHASE_DATE = offset measured from purchaseDate;
  // WARRANTY_EXPIRY = offset measured from warrantyExpiresAt.
  anchor              FollowUpStageAnchor  @default(WARRANTY_EXPIRY)
  offsetDays          Int                  @map("offset_days")
  template            String
  // Repurchase/renovation message used when the stage date already passed at
  // campaign activation time (HG-SEM-03). Falls back to campaign.template.
  templateOnPast      String?              @map("template_on_past")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  deletedAt           DateTime?            @map("deleted_at")
  deletedBy           String?              @map("deleted_by")

  sequence FollowUpSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@index([sequenceId])
  @@map("follow_up_sequence_stages")
}

/// Configuración efectiva por organización (specs/024-configuraciones-v1).
/// Una fila por organización; las columnas null significan "sin definir" y
/// caen a la variable de entorno y después al default del código.
/// No contiene credenciales: las integraciones siguen en .env.
model OrganizationConfig {
  id             String @id @default(cuid())
  uuid           String @unique @default(uuid())
  organizationId String @unique @map("organization_id")

  // Horarios (AU-009)
  businessHoursEnabled Boolean   @default(false) @map("business_hours_enabled")
  timezone             String    @default("America/Bogota")
  businessDays         String[]  @default(["MON", "TUE", "WED", "THU", "FRI"]) @map("business_days")
  // Minutos desde medianoche (0..1439); la ventana puede cruzar medianoche.
  businessHoursStart Int? @map("business_hours_start")
  businessHoursEnd   Int? @map("business_hours_end")

  // Parámetros de negocio no sensibles.
  maxCommercialPer60d           Int?    @map("max_commercial_per_60d")
  minDaysBetweenCommercial      Int?    @map("min_days_between_commercial")
  quoteExpiryDays               Int?    @map("quote_expiry_days")
  whatsappMessageCost           Int?    @map("whatsapp_message_cost")
  whatsappMessageCostCommercial Int?    @map("whatsapp_message_cost_commercial")
  smsCostPerSegment             Int?    @map("sms_cost_per_segment")
  smsCurrency                   String? @map("sms_currency")

  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("organization_configs")
}

model ChannelAccount {
  id                  String              @id @default(cuid())
  uuid                String              @unique @default(uuid())
  organizationId      String              @map("organization_id")
  channel             ChannelType
  provider            ChannelProvider
  label               String
  phoneNumber         String?             @map("phone_number")
  senderId            String?             @map("sender_id")
  status              ChannelAccountStatus @default(ACTIVE)
  isDefaultForChannel Boolean             @default(false) @map("is_default_for_channel")
  metadata            Json?
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  deletedAt           DateTime?           @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  messages     Message[]
  automations  Automation[]
  campaigns    Campaign[]

  @@unique([organizationId, channel, provider, senderId])
  @@index([organizationId])
  @@index([organizationId, channel])
  @@map("channel_accounts")
}

model Automation {
  id                String           @id @default(cuid())
  uuid              String           @unique @default(uuid())
  organizationId    String           @map("organization_id")
  campaignId        String?          @map("campaign_id")
  purchaseId        String           @map("purchase_id")
  commercialCycleId String?          @map("commercial_cycle_id")
  scheduledDate     DateTime         @map("scheduled_date")
  executedDate      DateTime?        @map("executed_date")
  status            AutomationStatus @default(PENDING)
  priority          Int              @default(0)
  // Attempts made; bounds automatic retries of ERROR automations.
  retryCount        Int              @default(0) @map("retry_count")
  // Anti-spam classification (playbook §14): only COMMERCIAL automations count
  // against the 3/60d limit; transactional (warranty/post-purchase) never block.
  purpose           AutomationPurpose @default(TRANSACTIONAL)
  // Snapshot of the FollowUpSequenceStage template at generation time.
  // When set, WhatsApp execution uses it directly instead of the legacy
  // campaign stage heuristics (templateD3/D180/D365).
  messageTemplate   String?          @map("message_template")
  // Fase 4 (T14): nombre legible del motivo/etapa ("Revisión mitad de garantía",
  // "Seguimiento postventa", "Recompra / renovación").
  stageName         String?          @map("stage_name")
  // Fase 1: canal de envío (snapshot de Campaign al momento de generación).
  channel           ChannelType      @default(WHATSAPP_CLIENTS)
  channelAccountId  String?          @map("channel_account_id")
  createdBy         String?          @map("created_by")
  updatedBy         String?          @map("updated_by")
  deletedBy         String?          @map("deleted_by")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  deletedAt         DateTime?        @map("deleted_at")

  organization    Organization     @relation(fields: [organizationId], references: [id])
  campaign        Campaign?        @relation(fields: [campaignId], references: [id])
  purchase        Purchase         @relation(fields: [purchaseId], references: [id])
  commercialCycle CommercialCycle? @relation(fields: [commercialCycleId], references: [id])
  channelAccount  ChannelAccount?  @relation(fields: [channelAccountId], references: [id])
  messages        Message[]

  @@index([organizationId])
  @@index([purchaseId])
  @@index([scheduledDate])
  @@index([status])
  @@index([organizationId, status])
  @@map("automations")
}

model Conversation {
  id             String             @id @default(cuid())
  uuid           String             @unique @default(uuid())
  organizationId String             @map("organization_id")
  customerId     String?            @map("customer_id")
  advisorId      String?            @map("advisor_id")
  channel        ChannelType
  status         ConversationStatus @default(OPEN)
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  deletedAt      DateTime?          @map("deleted_at")

  organization   Organization                @relation(fields: [organizationId], references: [id])
  customer       Customer?                   @relation(fields: [customerId], references: [id])
  advisor        User?                       @relation("ConversationAdvisor", fields: [advisorId], references: [id])
  complaints     Complaint[]
  messages       Message[]
  notes          ConversationNote[]
  tagAssignments ConversationTagAssignment[]

  @@index([organizationId])
  @@index([customerId])
  @@index([advisorId])
  @@index([status])
  @@index([organizationId, status])
  @@map("conversations")
}

model Message {
  id                     String           @id @default(cuid())
  uuid                   String           @unique @default(uuid())
  organizationId         String           @map("organization_id")
  conversationId         String?          @map("conversation_id")
  automationId           String?          @map("automation_id")
  customerId             String?          @map("customer_id")
  // Atribución de respuestas (Fase 2): cuando un mensaje entrante responde a
  // una automatización/campaña reciente, se guarda aquí su origen (uuid).
  inReplyToAutomationId  String?          @map("in_reply_to_automation_id")
  inReplyToCampaignId    String?          @map("in_reply_to_campaign_id")
  type                   MessageType
  content                String
  direction              MessageDirection
  status                 MessageStatus    @default(QUEUED)
  providerMessageId      String?          @map("provider_message_id")
  providerConversationId String?          @map("provider_conversation_id")
  // Fase 1: canal de envío (denormalized para queries).
  channel                ChannelType?
  channelAccountId       String?          @map("channel_account_id")
  provider               String?          @map("provider")
  // Fase 3: costo y segmentos.
  estimatedCost          Decimal?         @db.Decimal(10, 4) @map("estimated_cost")
  actualCost             Decimal?         @db.Decimal(10, 4) @map("actual_cost")
  currency               String?          @db.VarChar(3)
  segmentCount           Int?             @map("segment_count")
  failureReason          String?          @map("failure_reason")
  sentAt                 DateTime?        @map("sent_at")
  deliveredAt            DateTime?        @map("delivered_at")
  readAt                 DateTime?        @map("read_at")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")
  deletedAt              DateTime?        @map("deleted_at")

  organization    Organization    @relation(fields: [organizationId], references: [id])
  conversation    Conversation?   @relation(fields: [conversationId], references: [id])
  automation      Automation?     @relation(fields: [automationId], references: [id])
  customer        Customer?       @relation(fields: [customerId], references: [id])
  channelAccount  ChannelAccount? @relation(fields: [channelAccountId], references: [id])

  @@unique([organizationId, providerMessageId])
  @@index([organizationId])
  @@index([conversationId])
  @@index([automationId])
  @@index([customerId])
  @@index([channel])
  @@index([status])
  @@index([createdAt])
  @@index([organizationId, status])
  @@map("messages")
}

model ConversationTag {
  id             String    @id @default(cuid())
  uuid           String    @unique @default(uuid())
  organizationId String    @map("organization_id")
  name           String
  color          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization                @relation(fields: [organizationId], references: [id])
  assignments  ConversationTagAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("conversation_tags")
}

model ConversationTagAssignment {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  conversationId String    @map("conversation_id")
  tagId          String    @map("tag_id")
  createdById    String    @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization    @relation(fields: [organizationId], references: [id])
  conversation Conversation    @relation(fields: [conversationId], references: [id])
  tag          ConversationTag @relation(fields: [tagId], references: [id])
  createdBy    User            @relation("ConversationTagAssignmentCreator", fields: [createdById], references: [id])

  @@unique([conversationId, tagId])
  @@index([conversationId])
  @@index([tagId])
  @@index([organizationId])
  @@index([organizationId, tagId])
  @@map("conversation_tag_assignments")
}

model ConversationNote {
  id             String    @id @default(cuid())
  uuid           String    @unique @default(uuid())
  organizationId String    @map("organization_id")
  conversationId String    @map("conversation_id")
  userId         String    @map("user_id")
  content        String
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])
  author       User         @relation("ConversationNoteAuthor", fields: [userId], references: [id])

  @@index([conversationId, createdAt])
  @@index([organizationId])
  @@map("conversation_notes")
}

model QuickReply {
  id             String    @id @default(cuid())
  uuid           String    @unique @default(uuid())
  organizationId String    @map("organization_id")
  title          String
  body           String
  createdById    String    @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User         @relation("QuickReplyCreator", fields: [createdById], references: [id])

  @@index([organizationId])
  @@map("quick_replies")
}

model Import {
  id               String       @id @default(cuid())
  uuid             String       @unique @default(uuid())
  organizationId   String       @map("organization_id")
  userId           String       @map("user_id")
  type             ImportType
  fileName         String       @map("file_name")
  filePath         String       @map("file_path")
  fileHash         String?      @map("file_hash")
  idempotencyKey   String?      @map("idempotency_key")
  status           ImportStatus @default(PENDING)
  totalRecords     Int          @default(0) @map("total_records")
  processedRecords Int          @default(0) @map("processed_records")
  errorRecords     Int          @default(0) @map("error_records")
  errors           Json?
  startedAt        DateTime?    @map("started_at")
  completedAt      DateTime?    @map("completed_at")
  createdBy        String?      @map("created_by")
  updatedBy        String?      @map("updated_by")
  deletedBy        String?      @map("deleted_by")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  deletedAt        DateTime?    @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, fileHash])
  @@unique([organizationId, userId, idempotencyKey])
  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@index([organizationId, status])
  @@map("imports")
}

model UserSession {
  id               String    @id @default(cuid())
  uuid             String    @unique @default(uuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ip               String?
  expiresAt        DateTime  @map("expires_at")
  lastUsedAt       DateTime? @map("last_used_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Invitation {
  id             String           @id @default(cuid())
  uuid           String           @unique @default(uuid())
  organizationId String           @map("organization_id")
  invitedById    String           @map("invited_by_id")
  email          String
  roleId         String           @map("role_id")
  tokenHash      String           @map("token_hash")
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime         @map("expires_at")
  acceptedAt     DateTime?        @map("accepted_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  invitedBy    User         @relation("Inviter", fields: [invitedById], references: [id])

  @@index([organizationId])
  @@index([email])
  @@index([tokenHash])
  @@index([status])
  @@map("invitations")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  uuid      String    @unique @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model Audit {
  id             String   @id @default(cuid())
  uuid           String   @unique @default(uuid())
  organizationId String?  @map("organization_id")
  userId         String?  @map("user_id")
  module         String
  action         String
  description    String?
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
  @@map("audits")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AccountType {
  PLATFORM
  ORGANIZATION
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum RoleType {
  ADMINISTRADOR
  GERENTE
  OPERADOR
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  // Contact auto-created from an inbound WhatsApp message, awaiting
  // enrichment/verification (HG-AUD: Decisión 4).
  PENDING
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum PurchaseStatus {
  COMPLETED
  CANCELLED
  REFUNDED
}

enum QuoteStatus {
  DRAFT
  ENVIADA
  ACEPTADA
  RECHAZADA
  VENCIDA
}

enum CommercialCycleStatus {
  ACTIVE
  FINISHED
  CANCELLED
}

enum CampaignType {
  AUTOMATIC
  MANUAL
  REPURCHASE
  SPECIAL
}

enum CampaignStatus {
  DRAFT
  // Approved by marketing; activation from APPROVED only (playbook §20).
  APPROVED
  ACTIVE
  PAUSED
  FINISHED
  CANCELLED
}

enum AutomationStatus {
  PENDING
  SCHEDULED
  // Transient state while the provider send is in flight: never EXECUTED
  // before the send is confirmed (P1 production fix, demo decision D1).
  EXECUTING
  EXECUTED
  CANCELLED
  // The milestone elapsed while the lifecycle was paused or otherwise
  // suppressed, so it was no longer executable (spec 025 §4.5). Distinct from
  // CANCELLED: this was not a business decision, and no replacement message is
  // generated for it.
  SKIPPED
  ERROR
  PAUSED
}

// Por qué está pausado el lifecycle (spec 025 §10). Eje distinto del opt-out:
// el opt-out vive en customers.noContactAt y es global del cliente.
enum LifecyclePauseReason {
  HUMAN_ATTENTION
  COMPLAINT
  MANUAL
}

enum LifecycleTerminationReason {
  BATTERY_REPLACED
  DEFECTIVE_PRODUCT_RETURNED
  DEFECTIVE_PRODUCT_REPLACED
  COMPLAINT_CLOSED
  OPT_OUT
  MANUAL
}

// Resolución de una reclamación (spec 025 §6.1). Cada valor tiene una única
// transición sobre el lifecycle; ver §6.1.
enum ComplaintResolution {
  FALSE_ALARM
  TECHNICAL_ISSUE_RESOLVED
  BATTERY_REPLACED
  DEFECTIVE_PRODUCT_RETURNED
  DEFECTIVE_PRODUCT_REPLACED
  UNRESOLVED_NO_CONTACT
}

// Quién abrió una reclamación: la detectó el sistema o un asesor.
enum ComplaintOpenedBy {
  AUTO
  ADVISOR
}

// Ámbito de un consentimiento. MAINTENEMENTE gobierna los recordatorios de
// revisión; el resto se añade cuando exista decisión de negocio (spec 025 §4.6).
enum ConsentScope {
  MAINTENEMENT
}

enum ConsentDecision {
  GRANTED
  REFUSED
}

enum ConsentSource {
  INBOUND_MESSAGE
  ADVISOR
  IMPORT
}

enum AutomationPurpose {
  TRANSACTIONAL
  COMMERCIAL
}

enum FollowUpStageAnchor {
  PURCHASE_DATE
  WARRANTY_EXPIRY
}

enum ChannelType {
  WHATSAPP_CLIENTS
  WHATSAPP_SOCIAL
  SMS
}

enum ChannelProvider {
