APP_NAME=automatize-it-api
APP_VERSION=1.0.0
NODE_ENV=development
PORT=3000

DATABASE_URL=

JWT_SECRET=


REDIS_URL=

EVOLUTION_API_URL=

EVOLUTION_API_KEY=

WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_DEFAULT_ORGANIZATION_ID=
WHATSAPP_SANDBOX_ORGANIZATION_IDS=

# Pancake (WhatsApp via Pancake Public API). Optional and org-scoped: only
# PANCAKE_ORGANIZATION_ID routes its sends through Pancake. Leave unset to
# keep the default WhatsApp provider.
# PANCAKE_API_TOKEN=<page_access_token>
# PANCAKE_BOTCAKE_API_TOKEN=<token de Botcake > Configuración > Integraciones > API (Bearer, para message_templates)>
# PANCAKE_PAGE_ID=waba_1146111635255630
# PANCAKE_TEMPLATE_ID=<id de plantilla APPROVED (global v1: única para todos
#                    los envíos Pancake; sin ella el envío termina en error)>
# PANCAKE_ORGANIZATION_ID=<org id de Baterías del Caribe>
# PANCAKE_SENDER_ID=<opcional: user_id del emisor>
# PANCAKE_API_BASE_URL=https://pages.fm/api/public_api
# PANCAKE_TEMPLATES_API_URL=https://botcake.io/api/public_api/v1
# PANCAKE_TIMEOUT_MS=15000
# PANCAKE_MIN_INTERVAL_MS=250
# PANCAKE_RETRY_ON_AMBIGUOUS=false
# PANCAKE_RESOLVE_CONVERSATION_ID=false

# Journeys: máximo de automatizaciones comerciales por cliente cada 60 días.
# Las transaccionales (garantía/postventa) nunca cuentan para este límite.
JOURNEYS_MAX_COMMERCIAL_PER_60D=3

# Fase 4: distancia mínima (días) entre mensajes comerciales del mismo cliente.
JOURNEYS_MIN_DAYS_BETWEEN_COMMERCIAL=3

# Fase 3: costo estimado por mensaje de WhatsApp (COP) para previews de campaña.
# Fase P0.2 (D6): tarifas por propósito, preparadas para costos reales de Meta.
# Transaccional (automáticas/manuales) vs comercial (recompra/especial).
WHATSAPP_MESSAGE_COST=200
WHATSAPP_MESSAGE_COST_COMMERCIAL=400

# Fase P0-C: días que una cotización ENVIADA espera antes de pasar a VENCIDA.
QUOTE_EXPIRY_DAYS=7

# F7: timeout (ms) para automatizaciones huérfanas en EXECUTING (proveedor no
# confirmó). Vuelven a ERROR/retry; nunca se marcan EXECUTED automáticamente.
WHATSAPP_EXECUTING_TIMEOUT_MS=600000

JWT_REFRESH_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
INVITATION_TOKEN_TTL=48h
PASSWORD_RESET_TOKEN_TTL=1h
REFRESH_COOKIE_NAME=refresh_token
COOKIE_SECURE=true

# SMS provider configuration
# SMS_PROVIDER=ALTIRIA  (NULL | ALTIRIA | TWILIO | VONAGE | BIRD | INFOBIP | HABLAME)
# SMS_API_URL=https://www.altiria.net
# SMS_SENDER=
# SMS_WEBHOOK_BASE_URL=
# SMS_WEBHOOK_SECRET=
# SMS_DEFAULT_COUNTRY_PREFIX=57
# SMS_COST_PER_SEGMENT=100
# SMS_CURRENCY=COP
# SMS_COMMERCIAL_QUIET_HOURS_START=20
# SMS_COMMERCIAL_QUIET_HOURS_END=9
# SMS_TIMEZONE=America/Bogota
